# Copy to config.env and fill in. Keep config.env private (chmod 600); it holds
# your router password. config.env is gitignored and must never be committed.
#
# install_zte_watchdog.sh writes /opt/zte-watchdog/config.env for you from its
# own defaults (override any of them as env vars at install time). This file
# documents the full key set.

ROUTER_IP=192.168.0.1
ROUTER_PASSWORD=changeme
PING_TARGET=1.1.1.1

# --- polling and the recovery ladder ---
CHECK_INTERVAL=20
FAIL_THRESHOLD=3
COOLDOWN=180
# A cached router login older than this is re-authenticated before use. The stok
# is otherwise only dropped reactively, by a request that has already failed, so
# the first recovery action after a long healthy stretch would be spent on a dead
# session and still cost a full COOLDOWN.
SESSION_MAX_AGE=300
L2_MAX_PER_WINDOW=8
# Seconds between DISCONNECT and CONNECT in an L2 cycle. 3s appears to be too
# short for the modem to actually drop the bearer; a hand-driven toggle that
# works has a human-length pause in it.
L2_SETTLE=15
L3_MAX_PER_WINDOW=3
# Failed L2 attempts before escalating to reboot. At 3, with COOLDOWN=180, the
# first reboot lands 12 minutes into an outage -- long enough that a human beats
# it to the router.
L3_ESCALATION_THRESHOLD=2
# Measured on the MC801A: a reboot that comes back confirms readiness at ~120s.
# A floor under that probes a router that is still down; the ceiling must clear
# the floor by enough that "not confirmed" means wedged, not impatient.
L3_BOOT_WAIT=150
L3_READINESS_CEILING=300
ROUTER_DEAD_THRESHOLD=3
ADMIN_DEAD_RETRY_EVERY=10
ROLLING_WINDOW_SECONDS=86400

# DEBUG, INFO, WARNING, ERROR, CRITICAL (or a number). DEBUG adds the
# per-cycle heartbeats ("ping ok", "MTU probe ok at NNNNB") that INFO hides --
# a healthy watchdog is otherwise silent. An unrecognised value falls back to
# INFO and logs one FAULT line rather than refusing to start.
LOG_LEVEL=INFO

# --- MTU guard (path-MTU black-hole detection) ---
MTU_GUARD_ENABLED=1
# Set to 1 for detect-and-log-only; the guard then never writes to the router.
MTU_GUARD_DRY_RUN=0
# MTU_TARGET IS A PLACEHOLDER -- swap it for your own measured ceiling.
# It is carrier-specific and the value below is NOT a value to copy:
#   ping -M do -s N -c 3 8.8.8.8      # bisect N; ceiling = N + 28
# It must match what your path can actually carry. Too high (e.g. 1500 on a
# path that cannot carry it) and the guard re-detects a black hole every cycle
# and rewrites the same value until its breaker trips.
# See the "Path-MTU black holes" section of README.md.
MTU_TARGET=1360
# Hard floor: the guard refuses to write anything lower, whatever it measures.
MTU_FLOOR=1200
MTU_CHECK_EVERY=900
MTU_MAX_PER_WINDOW=4

# --- transport-plane check ---
# ICMP alone cannot see a TCP-level outage: the path can answer every ping while
# refusing every handshake. Use several different operators, so one provider
# having a bad day does not read as "the WAN is down" and reboot the router.
# Anycast resolvers stay reachable through outages that break everything else,
# so keep at least one target that is somewhere you actually need to reach --
# naming it by hostname also makes a resolver failure visible, which is worth
# knowing about too. WAN counts as down only when ICMP fails, or when EVERY TCP
# target refuses.
TCP_CHECK_ENABLED=1
TCP_CHECK_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443
TCP_CHECK_TIMEOUT=4

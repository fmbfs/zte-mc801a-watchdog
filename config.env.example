# Copy to config.env and fill in. Keep config.env private (chmod 600); it holds
# your router password. config.env is gitignored and must never be committed.
#
# install_zte_watchdog.sh writes /opt/zte-watchdog/config.env for you from its
# own defaults (override any of them as env vars at install time). This file
# documents the full key set.

ROUTER_IP=192.168.0.1
ROUTER_PASSWORD=changeme
PING_TARGET=1.1.1.1

# --- polling and the recovery ladder ---
CHECK_INTERVAL=20
FAIL_THRESHOLD=3
COOLDOWN=180
L2_MAX_PER_WINDOW=8
L2_SETTLE=3
L3_MAX_PER_WINDOW=3
L3_ESCALATION_THRESHOLD=3
L3_BOOT_WAIT=90
ROUTER_DEAD_THRESHOLD=3
ADMIN_DEAD_RETRY_EVERY=10
ROLLING_WINDOW_SECONDS=86400

# --- MTU guard (path-MTU black-hole detection) ---
MTU_GUARD_ENABLED=1
# Set to 1 for detect-and-log-only; the guard then never writes to the router.
MTU_GUARD_DRY_RUN=0
# MTU_TARGET IS A PLACEHOLDER -- swap it for your own measured ceiling.
# It is carrier-specific and the value below is NOT a value to copy:
#   ping -M do -s N -c 3 8.8.8.8      # bisect N; ceiling = N + 28
# It must match what your path can actually carry. Too high (e.g. 1500 on a
# path that cannot carry it) and the guard re-detects a black hole every cycle
# and rewrites the same value until its breaker trips.
# See the "Path-MTU black holes" section of README.md.
MTU_TARGET=1360
# Hard floor: the guard refuses to write anything lower, whatever it measures.
MTU_FLOOR=1200
MTU_CHECK_EVERY=900
MTU_MAX_PER_WINDOW=4

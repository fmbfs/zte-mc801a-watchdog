# Copy to config.env and fill in. Keep config.env private (chmod 600); it holds your password.
ROUTER_IP=192.168.0.1
ROUTER_PASSWORD=changeme
PING_TARGET=1.1.1.1
CHECK_INTERVAL=60
FAIL_THRESHOLD=3
COOLDOWN=180
MAX_REBOOTS_PER_WINDOW=8
ROLLING_WINDOW_SECONDS=86400
AUTH_MAX_FAILURES=4
RECONNECT_VERIFY_SECONDS=30

[Unit]
Description=ZTE MC801A connectivity watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/zte-watchdog/config.env
ExecStart=/opt/zte-watchdog/venv/bin/python3 /opt/zte-watchdog/zte_watchdog.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
